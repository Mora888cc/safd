title.BackgroundTransparency = 1
title.Text = "Weapon Tweaks"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.Parent = frame

for i, name in ipairs(ORDER) do
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -16, 0, 30)
	button.Position = UDim2.new(0, 8, 0, 34 + (i - 1) * 36)
	button.BackgroundColor3 = enabled[name] and ON_COLOR or OFF_COLOR
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Font = Enum.Font.GothamMedium
	button.TextSize = 14
	button.Text = name .. ": " .. (enabled[name] and "ON" or "OFF")
	button.Parent = frame
	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

	button.Activated:Connect(function()
		local state = not enabled[name]
		setCategory(name, state)
		button.Text = name .. ": " .. (state and "ON" or "OFF")
		button.BackgroundColor3 = state and ON_COLOR or OFF_COLOR
	end)
end

statusLabel = Instance.new("TextLabel")
