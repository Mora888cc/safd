local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local enabled = { Recoil = true, Spread = true, Sway = false }
local ORDER = { "Recoil", "Spread", "Sway" }

local CATEGORIES = {
	Recoil = { "recoil", "kick", "aimpunch" },
	Spread = { "spread", "bloom", "inaccuracy", "scatter", "dispersion", "deviation" },
	Sway = { "sway" },
}

local EXCLUDE = { "reduction", "reduce", "recover", "recovery", "decay", "regen" }

local entries = {}
local processed = {}
local counts = { Recoil = 0, Spread = 0, Sway = 0 }
local statusLabel

local function updateStatus()
	if statusLabel then
		statusLabel.Text = string.format("Found  R:%d  S:%d  W:%d", counts.Recoil, counts.Spread, counts.Sway)
	end
end

local function isExcluded(name)
	name = string.lower(name)
	for _, bad in ipairs(EXCLUDE) do
		if string.find(name, bad, 1, true) then
			return true
		end
	end
	return false
end

local function categoryOf(name)
	if isExcluded(name) then return nil end
	name = string.lower(name)
	for cat, words in pairs(CATEGORIES) do
		for _, word in ipairs(words) do
			if string.find(name, word, 1, true) then
				return cat
			end
		end
	end
	return nil
end

local function isTweakable(value)
	local t = typeof(value)
	return t == "number" or t == "Vector3" or t == "Vector2"
end

local function zeroOf(value)
	local t = typeof(value)
	if t == "Vector3" then return Vector3.zero end
	if t == "Vector2" then return Vector2.zero end
	return 0
end

local function register(cat, old, set, label)
	local entry = {
		cat = cat,
		label = label,
		zero = function() pcall(set, zeroOf(old)) end,
		restore = function() pcall(set, old) end,
	}
	table.insert(entries, entry)
	counts[cat] += 1
	updateStatus()
	if enabled[cat] then
		entry.zero()
	end
end

local function scanTable(tbl, seen, inherited, path)
	if seen[tbl] then return end
	seen[tbl] = true
	for key, value in pairs(tbl) do
		local keyName = type(key) == "string" and key or nil
		if not (keyName and isExcluded(keyName)) then
			local cat = (keyName and categoryOf(keyName)) or inherited
			local subPath = path .. "." .. tostring(key)
			if type(value) == "table" then
				scanTable(value, seen, cat, subPath)
			elseif cat and isTweakable(value) then
				register(cat, value, function(v) tbl[key] = v end, subPath)
			end
		end
	end
end

local function processInstance(inst)
	if processed[inst] then return end
	processed[inst] = true

	if inst:IsA("NumberValue") or inst:IsA("IntValue") or inst:IsA("Vector3Value") then
		local cat = categoryOf(inst.Name)
		if cat then
			register(cat, inst.Value, function(v) inst.Value = v end, inst:GetFullName())
		end
	end

	for name, value in pairs(inst:GetAttributes()) do
		local cat = categoryOf(name)
		if cat and isTweakable(value) then
			register(cat, value, function(v) inst:SetAttribute(name, v) end, inst:GetFullName() .. "@" .. name)
		end
	end

	if inst:IsA("ModuleScript") then
		task.spawn(function()
			local ok, result = pcall(require, inst)
			if ok and type(result) == "table" then
				local ok2, err = pcall(scanTable, result, {}, nil, inst:GetFullName())
				if not ok2 then warn("[WeaponTweaks] " .. tostring(err)) end
			end
		end)
	end
end

local function safeProcess(inst)
	local ok, err = pcall(processInstance, inst)
	if not ok then
		warn("[WeaponTweaks] " .. tostring(err))
	end
end

local function watch(root)
	if not root then return end
	safeProcess(root)
	local descendants = root:GetDescendants()
	for i, inst in ipairs(descendants) do
		safeProcess(inst)
		if i % 400 == 0 then task.wait() end
	end
	root.DescendantAdded:Connect(safeProcess)
end

local function setCategory(cat, state)
	enabled[cat] = state
	for _, entry in ipairs(entries) do
		if entry.cat == cat then
			if state then entry.zero() else entry.restore() end
		end
	end
end

local ON_COLOR = Color3.fromRGB(60, 170, 90)
local OFF_COLOR = Color3.fromRGB(170, 60, 60)

local oldGui = playerGui:FindFirstChild("WeaponTweaksGui")
if oldGui then oldGui:Destroy() end

