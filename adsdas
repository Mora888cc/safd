	if not processedByUI and input.KeyCode == Enum.KeyCode.RightShift then
		frame.Visible = not frame.Visible
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		for _, entry in ipairs(entries) do
			if enabled[entry.cat] then
				entry.zero()
			end
		end
	end
end)

